{
  "name": "thrills-and-chills",
  "private": true,
  "version": "3.0.0",
  "description": "Thrills & Chills: an original isometric theme-park management game for the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test --trace off"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
